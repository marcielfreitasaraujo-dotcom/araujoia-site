# Copie para .env para rodar localmente (npm run dev). NUNCA faça commit do arquivo .env.
# Em produção, cadastre estas variáveis em: Netlify > Site configuration > Environment variables.

# --- Obrigatórias para o formulário aparecer no site ---------------------------------
# Senha de acesso ao painel /admin (escolha uma senha longa e única).
ADMIN_PASSWORD=
# Texto aleatório longo (32+ caracteres) usado para assinar tokens anti-spam e sessões.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=

# --- Notificação por e-mail (Resend) --------------------------------------------------
# Sem estas duas, os contatos são salvos normalmente, mas nenhum e-mail é enviado.
RESEND_API_KEY=
# E-mail que receberá o aviso de novo contato.
NOTIFY_EMAIL=
# Opcional. Remetente. Padrão: "Araujo.IA <onboarding@resend.dev>" (só entrega ao e-mail da sua conta Resend).
# Depois de verificar um domínio no Resend, use algo como: Araujo.IA <contato@seudominio.com.br>
NOTIFY_FROM=

# --- Opcionais ------------------------------------------------------------------------
# Domínios extras autorizados a enviar o formulário (separados por vírgula), além do próprio site.
ALLOWED_ORIGINS=
# Somente desenvolvimento: usa arquivos em .data/ no lugar do Netlify Blobs.
LEADS_STORAGE=file
