# NENHUMA variável é obrigatória para o formulário funcionar: por padrão ele usa o Netlify Forms
# (guarda cada envio no painel do Netlify e avisa por e-mail quem estiver em Forms > Notifications).
# Estas variáveis são OPCIONAIS. Em produção cadastre em: Netlify > Site configuration > Environment variables.
# Para rodar localmente copie este arquivo para .env (NUNCA faça commit do .env).

# --- Painel privado /admin (opcional) --------------------------------------------------
# Define a senha do painel. Sem ela, o painel fica desativado (use o painel de Forms do Netlify).
ADMIN_PASSWORD=

# --- Aviso por e-mail via Resend (opcional, em adição ao Netlify Forms) ----------------
RESEND_API_KEY=
NOTIFY_EMAIL=
# Remetente. Padrão: "Araujo.IA <onboarding@resend.dev>" (só entrega ao e-mail da sua conta Resend).
NOTIFY_FROM=

# --- Avançado -------------------------------------------------------------------------
# Texto aleatório (32+ caracteres) para assinar tokens e sessões. Se vazio, o servidor gera um e guarda sozinho.
FORM_SECRET=
# Use "off" para desligar o envio ao Netlify Forms.
NETLIFY_FORMS=
# Domínios extras autorizados a enviar o formulário (separados por vírgula).
ALLOWED_ORIGINS=
# Dias sem atividade até a exclusão automática do contato (padrão 365).
RETENTION_DAYS=
# Somente desenvolvimento: usa arquivos em .data/ no lugar do Netlify Blobs.
LEADS_STORAGE=file
